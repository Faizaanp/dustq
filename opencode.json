{
  "$schema": "https://opencode.ai/config.json",
  "model": "kaggle-gemini/google/gemini-3.6-flash",
  "provider": {
    "kaggle-gemini": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Kaggle - Gemini",
      "options": {
        "baseURL": "https://mp-staging.kaggle.net/models/openapi/v1",
        "apiKey": "kaggleweb:"
      },
      "models": {
        "google/gemini-3.6-flash": {
          "name": "Gemini 3.6 Flash (Reasoning Enabled)"
        },
        "google/gemini-3.5-flash-lite": {
          "name": "Gemini 3.5 Flash Lite (Ultra Fast)"
        },
        "google/gemini-3.1-flash-lite": {
          "name": "Gemini 3.1 Flash Lite"
        },
        "google/gemini-3-flash-preview": {
          "name": "Gemini 3 Flash Preview"
        }
      }
    },
    "kaggle-claude": {
      "npm": "@ai-sdk/anthropic",
      "name": "Kaggle - Claude",
      "options": {
        "baseURL": "https://mp-staging.kaggle.net/models/anthropic/v1",
        "apiKey": "kaggleweb:"
      },
      "models": {
        "claude-sonnet-5@default": {
          "name": "Claude Sonnet (Thinking / Vertex AI)"
        },
        "anthropic/claude-sonnet-5@default": {
          "name": "Claude Sonnet (Full ID)"
        }
      }
    },
    "kaggle-openai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Kaggle - OpenAI / OSS",
      "options": {
        "baseURL": "https://mp-staging.kaggle.net/models/openapi/v1",
        "apiKey": "kaggleweb:"
      },
      "models": {
        "openai/gpt-5.4-nano-2026-03-17": {
          "name": "GPT-5.4 Nano (430ms Fast)"
        },
        "openai/gpt-oss-120b": {
          "name": "GPT-OSS 120B (120B Open Weights)"
        }
      }
    },
    "kaggle-granite": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Kaggle - IBM Granite",
      "options": {
        "baseURL": "https://mp-staging.kaggle.net/models/openapi/v1",
        "apiKey": "kaggleweb:"
      },
      "models": {
        "ibm/granite-4.0-h-small": {
          "name": "IBM Granite 4.0 H-Small (Reasoning)"
        }
      }
    }
  }
}

